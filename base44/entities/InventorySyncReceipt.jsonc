{
  "name": "InventorySyncReceipt",
  "type": "object",
  "description": "Persistent receipt generated by the Inventory ingestion engine after processing a ScanOps bridge event. Returned to ScanOps to update outbox sync status. Immutable after creation \u2014 one receipt per ingestion decision.",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Unique identifier for this receipt record. Generated by Inventory on creation."
    },
    "event_id": {
      "type": "string",
      "description": "ScanOps event_id this receipt corresponds to. Must match the original bridge envelope event_id."
    },
    "ingestion_id": {
      "type": "string",
      "description": "Reference to the InventorySyncInboundEvent ledger record that produced this receipt."
    },
    "status": {
      "type": "string",
      "enum": [
        "ACK_RECEIVED",
        "ACK_PROCESSED",
        "ACK_DUPLICATE",
        "HELD_FOR_REVIEW",
        "REJECTED_SCHEMA",
        "REJECTED_AUTH",
        "REJECTED_STALE_SNAPSHOT",
        "REJECTED_CONFLICT",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL",
        "QUARANTINED"
      ],
      "description": "Ingestion decision status returned to ScanOps. ScanOps maps this to its internal outbox sync status vocabulary."
    },
    "inventory_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when Inventory received the original ScanOps event."
    },
    "inventory_processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when Inventory completed processing and issued this receipt."
    },
    "decision_code": {
      "type": "string",
      "description": "Machine-readable decision code matching the receipt status. Used by ScanOps to apply the correct outbox status transition."
    },
    "decision_message": {
      "type": "string",
      "description": "Human-readable explanation of the ingestion decision. Surfaced in ScanOps sync queue for operator review."
    },
    "linked_workflow_ref": {
      "type": "string",
      "description": "Optional reference to a downstream Inventory workflow record (e.g. markdown review queue entry) created as a result of this event. Null if not routed."
    },
    "retry_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Whether ScanOps is allowed to replay this event. True only for FAILED_RETRYABLE and HELD_FOR_REVIEW (after manual release). False for all terminal statuses."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this receipt record was created. Immutable after creation."
    }
  },
  "required": [
    "receipt_id",
    "event_id",
    "ingestion_id",
    "status",
    "inventory_received_at",
    "decision_code",
    "retry_allowed",
    "created_at"
  ]
}