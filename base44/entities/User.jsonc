{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "scanops_role": {
      "type": "string",
      "enum": [
        "Admin",
        "Manager",
        "Supervisor",
        "Staff"
      ],
      "default": "Staff",
      "title": "ScanOps Role",
      "description": "Operational role within ScanOps. Maps to permissions for markdowns, waste approvals, governance, and reporting."
    }
  }
}