{
  "name": "MarkdownSyncReviewQueue",
  "type": "object",
  "description": "Review-only holding queue for ScanOps markdown bridge events received by Inventory. Records here represent events that require human or workflow review before any Inventory action is taken. This entity MUST NOT be used to activate prices, deduct stock, create StockMovements, POSLineItems, purchase orders, or forecasting records. It is a capture-only review surface.",
  "properties": {
    "review_id": {
      "type": "string",
      "description": "Unique identifier for this review queue record. Generated by Inventory ingestion engine on routing."
    },
    "ingestion_id": {
      "type": "string",
      "description": "Reference to the InventorySyncInboundEvent ledger record. Used as the idempotency key for routing \u2014 one review record per ingestion_id."
    },
    "event_id": {
      "type": "string",
      "description": "ScanOps event_id from the bridge envelope."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "scanops.markdown.requested",
        "scanops.markdown.approved",
        "scanops.markdown.returned",
        "scanops.markdown.rejected",
        "scanops.markdown.handoff.created"
      ],
      "description": "Bridge event type from the ScanOps envelope."
    },
    "source_system": {
      "type": "string",
      "default": "scanops",
      "description": "Originating system. Always 'scanops' for Phase 1C records."
    },
    "source_device_id": {
      "type": "string",
      "description": "Scanner device ID from the ScanOps bridge envelope."
    },
    "source_session_id": {
      "type": "string",
      "description": "ScanOps session ID from the bridge envelope."
    },
    "source_user_id": {
      "type": "string",
      "description": "ScanOps actor user ID from the bridge envelope."
    },
    "source_user_role": {
      "type": "string",
      "description": "ScanOps actor role from the bridge envelope."
    },
    "inventory_snapshot_ref": {
      "type": "string",
      "description": "Snapshot reference from the ScanOps bridge envelope."
    },
    "inventory_snapshot_hash": {
      "type": "string",
      "description": "Snapshot hash from the ScanOps bridge envelope."
    },
    "inventory_record_version": {
      "type": "string",
      "description": "Inventory record version cached on the ScanOps device at capture time."
    },
    "payload_hash": {
      "type": "string",
      "description": "Deterministic hash of the event payload. Used for audit and integrity reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_REVIEW",
        "HELD_FOR_REVIEW",
        "READY_FOR_SUPERVISOR_REVIEW",
        "RESOLVED",
        "REJECTED"
      ],
      "default": "PENDING_REVIEW",
      "description": "Current review status. Phase 1C-E only creates PENDING_REVIEW and HELD_FOR_REVIEW. Resolution actions belong to a future phase."
    },
    "review_reason": {
      "type": "string",
      "description": "Machine-readable review reason code. Set by the ingestion engine based on event type and decision."
    },
    "decision_code": {
      "type": "string",
      "description": "Ingestion decision code from the engine that triggered this review record."
    },
    "decision_reason": {
      "type": "string",
      "description": "Human-readable explanation of why this event was routed to review."
    },
    "sku": {
      "type": "string",
      "description": "Item SKU from the event payload snapshot. For display/review only."
    },
    "barcode": {
      "type": "string",
      "description": "Item barcode from the event payload snapshot. For display/review only."
    },
    "item_name_snapshot": {
      "type": "string",
      "description": "Item name as captured in the ScanOps event payload. Evidence only \u2014 not the live Inventory item name."
    },
    "markdown_request_ref": {
      "type": "string",
      "description": "Reference to the ScanOps-side markdown request that generated this event."
    },
    "markdown_batch_ref": {
      "type": "string",
      "description": "Optional markdown batch reference from the event payload."
    },
    "markdown_round_ref": {
      "type": "string",
      "description": "Optional markdown round reference from the event payload."
    },
    "quantity": {
      "type": "number",
      "description": "Quantity from the event payload. Evidence only."
    },
    "discount_percent": {
      "type": "number",
      "description": "Markdown discount percentage from the event payload. Evidence only \u2014 does not activate pricing."
    },
    "reason_code": {
      "type": "string",
      "description": "Markdown reason code from the event payload (e.g. short_dated, overstock)."
    },
    "linked_inbound_event_ref": {
      "type": "string",
      "description": "Reference to the InventorySyncInboundEvent ingestion_id. Equivalent to ingestion_id but explicit for audit trail clarity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this review queue record was created."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this review queue record was last updated."
    }
  },
  "required": [
    "review_id",
    "ingestion_id",
    "event_id",
    "event_type",
    "source_system",
    "payload_hash",
    "status",
    "review_reason",
    "created_at"
  ]
}