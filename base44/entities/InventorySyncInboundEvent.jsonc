{
  "name": "InventorySyncInboundEvent",
  "type": "object",
  "description": "Immutable ledger of every ScanOps bridge event received by the Inventory system. Written before any decisioning or workflow routing. Status and decision fields are the only mutable surface after initial write.",
  "properties": {
    "ingestion_id": {
      "type": "string",
      "description": "Unique identifier for this ingestion ledger record (generated by Inventory on receipt)."
    },
    "event_id": {
      "type": "string",
      "description": "ScanOps-assigned event_id from the bridge envelope. Used for idempotency lookup."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "scanops.markdown.requested",
        "scanops.markdown.approved",
        "scanops.markdown.returned",
        "scanops.markdown.rejected",
        "scanops.markdown.handoff.created"
      ],
      "description": "Bridge event type from the ScanOps envelope. Phase 1C-A supports markdown events only."
    },
    "event_version": {
      "type": "string",
      "description": "Schema version string from the ScanOps bridge envelope (e.g. '1.0')."
    },
    "source_system": {
      "type": "string",
      "default": "scanops",
      "description": "Originating system identifier. Must be 'scanops' for all Phase 1C events."
    },
    "source_device_id": {
      "type": "string",
      "description": "Scanner device ID from the ScanOps bridge envelope."
    },
    "source_session_id": {
      "type": "string",
      "description": "ScanOps session ID from the bridge envelope."
    },
    "source_user_id": {
      "type": "string",
      "description": "ScanOps actor user ID from the bridge envelope."
    },
    "source_user_role": {
      "type": "string",
      "description": "ScanOps actor role from the bridge envelope (e.g. Staff, Supervisor, Manager)."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when Inventory received the event from ScanOps."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when Inventory completed ingestion processing and wrote the ledger decision."
    },
    "status": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "VALIDATING",
        "PROCESSED",
        "HELD_FOR_REVIEW",
        "REJECTED_SCHEMA",
        "REJECTED_AUTH",
        "REJECTED_STALE_SNAPSHOT",
        "REJECTED_CONFLICT",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL",
        "QUARANTINED",
        "DUPLICATE"
      ],
      "default": "RECEIVED",
      "description": "Current ingestion status. Progresses from RECEIVED \u2192 VALIDATING \u2192 terminal state. Conflict and quarantine are expressed as status values here \u2014 no separate entity."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Composite idempotency key: event_id + source_device_id + source_session_id + event_type. Used to detect replays and duplicate sends."
    },
    "inventory_snapshot_id": {
      "type": "string",
      "description": "Snapshot ID from the ScanOps envelope \u2014 identifies which Inventory cache state the event was built against."
    },
    "inventory_snapshot_ref": {
      "type": "string",
      "description": "Human-readable snapshot reference string from the ScanOps envelope."
    },
    "inventory_snapshot_hash": {
      "type": "string",
      "description": "Deterministic hash of the inventory snapshot at the time of capture on the ScanOps device."
    },
    "inventory_record_version": {
      "type": "string",
      "description": "Version identifier of the Inventory record that was cached on the ScanOps device."
    },
    "last_inventory_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last successful Inventory cache sync on the ScanOps device before this event was created."
    },
    "payload_hash": {
      "type": "string",
      "description": "Deterministic djb2 hash of the event payload from the ScanOps envelope. Used for payload integrity validation and conflict detection."
    },
    "payload_summary": {
      "type": "string",
      "description": "Human-readable summary of the event payload for ledger display (e.g. item name, markdown %, reason). Never used for business logic."
    },
    "decision": {
      "type": "string",
      "description": "High-level ingestion decision written by the ingestion engine (e.g. ACCEPT, HOLD, REJECT, DUPLICATE). Set after validation is complete."
    },
    "decision_code": {
      "type": "string",
      "description": "Machine-readable decision code corresponding to the ingestion outcome (e.g. REJECTED_STALE_SNAPSHOT, ACK_PROCESSED). Matches the receipt status vocabulary."
    },
    "decision_reason": {
      "type": "string",
      "description": "Human-readable explanation of the ingestion decision for audit/review purposes."
    },
    "linked_inventory_workflow_ref": {
      "type": "string",
      "description": "Reference to a downstream Inventory workflow record created or updated as a result of this event (if any). Null if not yet routed."
    },
    "linked_markdown_ref": {
      "type": "string",
      "description": "Reference to the Inventory-side markdown record linked to this event (if applicable)."
    },
    "audit_log_ref": {
      "type": "string",
      "description": "Reference to an external or existing AuditLog record for this ingestion event, if the project maintains a shared audit log entity."
    },
    "raw_event_json": {
      "type": "object",
      "description": "Full verbatim ScanOps bridge event envelope as received. Stored for audit and replay. Never mutated after initial write."
    }
  },
  "required": [
    "ingestion_id",
    "event_id",
    "event_type",
    "source_system",
    "received_at",
    "status",
    "idempotency_key",
    "payload_hash"
  ]
}