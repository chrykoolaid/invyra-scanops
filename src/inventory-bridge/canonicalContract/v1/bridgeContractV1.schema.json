{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invyra.scanops.inventory-bridge.v1.0.0.schema.json",
  "title": "Invyra ScanOps ↔ Inventory Bridge Contract v1",
  "description": "Canonical, machine-comparable bridge contract definition. Contract-only; no runtime activation.",
  "type": "object",
  "required": [
    "contractId",
    "schemaVersion",
    "canonicalFieldStyle",
    "operationTypes",
    "envelope",
    "environments",
    "receipt",
    "errorObject",
    "endpointDescriptors",
    "contentType",
    "httpServerImplemented",
    "failClosedPolicy",
    "runtimeActivation"
  ],
  "properties": {
    "contractId": { "type": "string", "const": "invyra.scanops.inventory-bridge" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "canonicalFieldStyle": { "type": "string", "const": "camelCase" },
    "operationTypes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 9,
      "uniqueItems": true
    },
    "envelope": {
      "type": "object",
      "required": [
        "requiredTopLevelFields",
        "source",
        "target",
        "placeholderIdsRejected",
        "noDefaultIdentifiers",
        "missingIdentifiersMustFail"
      ],
      "properties": {
        "requiredTopLevelFields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 11,
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "required": ["requiredFields", "systemMustEqual", "operatorId"],
          "properties": {
            "requiredFields": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 4,
              "uniqueItems": true
            },
            "systemMustEqual": { "type": "string", "const": "SCANOPS" },
            "operatorId": {
              "type": "object",
              "required": ["required", "exceptionOperations"],
              "properties": {
                "required": { "type": "boolean", "const": true },
                "exceptionOperations": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            }
          }
        },
        "target": {
          "type": "object",
          "required": ["requiredFields", "systemMustEqual", "inventoryInstanceIdRequired"],
          "properties": {
            "requiredFields": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 2,
              "uniqueItems": true
            },
            "systemMustEqual": { "type": "string", "const": "INVENTORY" },
            "inventoryInstanceIdRequired": { "type": "boolean", "const": true }
          }
        },
        "placeholderIdsRejected": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "uniqueItems": true
        },
        "noDefaultIdentifiers": { "type": "boolean", "const": true },
        "missingIdentifiersMustFail": { "type": "boolean", "const": true }
      }
    },
    "environments": {
      "type": "object",
      "required": [
        "recognized",
        "allowedRuntime",
        "blockedRuntime",
        "unknownInvalid",
        "noDefault",
        "thisPhaseDoesNotActivateRuntime"
      ],
      "properties": {
        "recognized": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "uniqueItems": true
        },
        "allowedRuntime": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "uniqueItems": true
        },
        "blockedRuntime": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "uniqueItems": true
        },
        "unknownInvalid": { "type": "boolean", "const": true },
        "noDefault": { "type": "boolean", "const": true },
        "thisPhaseDoesNotActivateRuntime": { "type": "boolean", "const": true }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["requiredFields", "admissionStatuses", "applicationStatuses"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 16,
          "uniqueItems": true
        },
        "admissionStatuses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "uniqueItems": true
        },
        "applicationStatuses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 10,
          "uniqueItems": true
        }
      }
    },
    "errorObject": {
      "type": "object",
      "required": ["requiredFields", "codeFormat", "coreRegistry"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "uniqueItems": true
        },
        "codeFormat": { "type": "string", "const": "UPPER_SNAKE_CASE" },
        "coreRegistry": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 23,
          "uniqueItems": true
        }
      }
    },
    "endpointDescriptors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "descriptorOnly", "implemented"],
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST"] },
          "path": { "type": "string" },
          "descriptorOnly": { "type": "boolean", "const": true },
          "implemented": { "type": "boolean", "const": false }
        }
      },
      "minItems": 3
    },
    "contentType": { "type": "string", "const": "application/json" },
    "httpServerImplemented": { "type": "boolean", "const": false },
    "failClosedPolicy": {
      "type": "object",
      "required": [
        "emptyAcceptedSchemaListDenies",
        "emptyAcceptedOperationListDenies",
        "emptyTrustedDeviceListDenies",
        "emptyAllowedStoreListDenies",
        "missingEnvironmentDenies",
        "missingInventoryInstanceDenies",
        "contractMajorVersionMismatchDenies",
        "unknownOperationDenies"
      ],
      "properties": {
        "emptyAcceptedSchemaListDenies": { "type": "boolean", "const": true },
        "emptyAcceptedOperationListDenies": { "type": "boolean", "const": true },
        "emptyTrustedDeviceListDenies": { "type": "boolean", "const": true },
        "emptyAllowedStoreListDenies": { "type": "boolean", "const": true },
        "missingEnvironmentDenies": { "type": "boolean", "const": true },
        "missingInventoryInstanceDenies": { "type": "boolean", "const": true },
        "contractMajorVersionMismatchDenies": { "type": "boolean", "const": true },
        "unknownOperationDenies": { "type": "boolean", "const": true }
      }
    },
    "runtimeActivation": {
      "type": "object",
      "required": [
        "thisPhaseDoesNotActivateRuntime",
        "liveAndProductionBlockedBySeparateRuntimePolicy",
        "noNetworkCalls",
        "noPersistence",
        "noMutation"
      ],
      "properties": {
        "thisPhaseDoesNotActivateRuntime": { "type": "boolean", "const": true },
        "liveAndProductionBlockedBySeparateRuntimePolicy": { "type": "boolean", "const": true },
        "noNetworkCalls": { "type": "boolean", "const": true },
        "noPersistence": { "type": "boolean", "const": true },
        "noMutation": { "type": "boolean", "const": true }
      }
    }
  },
  "additionalProperties": false
}